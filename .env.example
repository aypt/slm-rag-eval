# Copy to .env and adjust. .env is gitignored — never commit real secrets.
# Values below are the compose defaults; the code's own defaults assume a local install.

# --- judge backend -----------------------------------------------------------
# Inside compose the judge is the ollama service; locally use http://localhost:11434/v1
SLMEVAL_BASE_URL=http://ollama:11434/v1
SLMEVAL_MODEL=qwen2.5:7b-instruct
# Model pulled by the ollama-init service; keep it equal to SLMEVAL_MODEL.
JUDGE_MODEL=qwen2.5:7b-instruct
# Leave unset for an unsecured local Ollama; set it for backends needing bearer auth.
# SLMEVAL_API_KEY=
SLMEVAL_TIMEOUT_S=120
SLMEVAL_MAX_RETRIES=3

# --- metrics -----------------------------------------------------------------
SLMEVAL_ENABLED_METRICS=["faithfulness"]
SLMEVAL_K=1
SLMEVAL_STRICT=true

# --- privacy -----------------------------------------------------------------
# mask (default) sanitizes every request before it reaches the judge or the database.
SLMEVAL_PRIVACY_MODE=mask
SLMEVAL_PRIVACY_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","CREDIT_CARD","IP_ADDRESS","LOCATION","US_SSN"]
SLMEVAL_PRIVACY_SCORE_THRESHOLD=0.4

# --- service -----------------------------------------------------------------
# Compose Postgres. For a local run: sqlite+aiosqlite:///data/jobs.db
DATABASE_URL=postgresql+asyncpg://slmeval:slmeval@db:5432/slmeval
# 1 runs the worker inside the API process; compose sets 0 and runs a worker service.
WORKER_EMBEDDED=1
WORKER_CONCURRENCY=2
